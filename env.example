# .env.example — copy to attendance_system/.env and fill in values
DB_HOST=db
DB_PORT=3306
DB_USER=root
DB_PASS=your_password_here
DB_NAME=attendance_system

SECRET_KEY=change_this_to_a_random_64_char_string

SERVICE_ACCOUNT_FILE=credentials.json
SHEET_ID=your_google_sheet_id
SHEET_RANGE=Form Responses 3!A:Z

RECOGNITION_THRESHOLD=0.35
DETECTION_THRESHOLD=0.60
LIVENESS_THRESHOLD=0.7
MIN_FACE_SIZE=80
ATTENDANCE_COOLDOWN_MIN=55
RECOGNITION_FPS=8
MAX_STREAM_THREADS=10

SESSION_AUTO_OPEN_TIME=08:00
INSIGHTFACE_MODEL=buffalo_l

OPENROUTER_API_KEY=your_key_here